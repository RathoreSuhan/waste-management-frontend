# ============================================================================
# Clean Bharat - Frontend Environment
# ============================================================================
#
# Copy this file to .env.local for local development:
#     copy .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the browser. Vite
# inlines them at BUILD time, so anything placed here ends up readable in
# the shipped bundle. Never put a secret in this file - no Cloudinary
# secret, no Gemini key, no database credentials. Those belong on the
# backend only.
# ============================================================================

# Base URL of the Spring Boot backend, with no trailing slash.
#
# Local development (default when this variable is absent):
VITE_API_BASE_URL=http://localhost:8080

# On Vercel, set this in Project Settings -> Environment Variables to the
# Render service URL instead, for example:
#     VITE_API_BASE_URL=https://clean-bharat-api.onrender.com
#
# Remember to redeploy after changing it: the value is baked into the
# bundle at build time, so an existing deployment will not pick it up.
